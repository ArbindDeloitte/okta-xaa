# Second, limited agent: a second copy of the agent app that signs in as a DIFFERENT Okta agent with fewer scopes.
# Copy to .env.limited (git-ignored). Values here override .env for that copy only.
# Run it with:  npm run dev:agent-limited   (or all four services: npm run start:both)

# Shown in the header after "HPE"
AGENT_NAME=Ops Agent (Limited)

# Its own port. Register http://localhost:3002/callback as the sign-in redirect URI on the limited agent's app in Okta.
AGENT_PORT=3002
AGENT_BASE_URL=http://localhost:3002

# Client ID of the LIMITED agent's linked OIDC app in Okta
AGENT_CLIENT_ID=

# Separate key pair for this agent: npm run gen:key -- --name limited   (npm run show:key -- --name limited prints the public JWK)
AGENT_PRIVATE_KEY_FILE=.keys/agent-limited-private.jwk.json

# Only if the KID Okta shows for the registered public key differs from the one in the key file
AGENT_KEY_ID=

# This agent's identity at the order portal. In Okta's resource connection for this agent, set
# "AI agent's client ID registered in this app" to the same RETAIL_AGENT_CLIENT_ID.
# The auth server must know it too: RETAIL_AGENT_CLIENTS=<id>:<secret> in the main .env.
RETAIL_AGENT_CLIENT_ID=limited-agent-at-retail
RETAIL_AGENT_CLIENT_SECRET=

# Must be a SUBSET of what Okta allows on this agent's resource connection (Okta refuses any scope it does not allow).
RETAIL_SCOPES=products:read inventory:read orders:read
