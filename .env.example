# Copy to .env and fill in. One file is shared by all three services.

# ───────── Okta (the enterprise IdP; issues the ID-JAG) ─────────
# Org authorization server URL, e.g. https://acme.oktapreview.com  (no /oauth2/default)
OKTA_ISSUER=

# The agent app registered in Okta (AI agent's linked OIDC app) - copy its Client ID
AGENT_CLIENT_ID=

# How the agent authenticates to Okta: private_key_jwt (default) | client_secret
#   private_key_jwt: run `npm run gen:key`, paste the printed public JWK into the agent's
#                    "Client registration -> Public/private key" in Okta. (`npm run show:key` re-prints it.)
AGENT_AUTH_METHOD=private_key_jwt
# AGENT_PRIVATE_KEY_FILE=.keys/agent-private.jwk.json
#   Okta may assign its OWN Key ID to the public key you paste in. If the KID shown in Okta differs from `npm run show:key`,
#   set it here (the JWT header kid must equal Okta's Key ID):
# AGENT_KEY_ID=
#   client_secret:   set AGENT_AUTH_METHOD=client_secret and AGENT_CLIENT_SECRET below
# AGENT_CLIENT_SECRET=

# ───────── Agent app (port 3000) ─────────
AGENT_PORT=3000
AGENT_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
# Set to true to also end the Okta session on sign-out (needs http://localhost:3000/ registered as a sign-out redirect URI)
# AGENT_OKTA_LOGOUT=false

# ───────── LLM: pick ONE provider ─────────
# LLM_PROVIDER=anthropic | groq   (default: auto; groq only if it is the only key present)
# Option 1: Anthropic API (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Option 2: Groq (OpenAI-compatible, has a free tier with rate limits). Key: console.groq.com/keys (gsk_..., 56 chars)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Option 3: Claude on Amazon Bedrock (Mantle, Anthropic-compatible endpoint) instead of api.anthropic.com ---
#   Put the Bedrock API key in ANTHROPIC_API_KEY (or BEDROCK_API_KEY). Short-term Bedrock keys expire after hours: regenerate when you see "Signature expired".
# ANTHROPIC_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/anthropic
# AGENT_MODEL_ID=anthropic.claude-haiku-4-5
# AWS_REGION=us-east-1

# What the agent exchanges for the ID-JAG: refresh_token (current Okta docs) | id_token (older flow)
# XAA_SUBJECT_TOKEN=refresh_token
# XAA_SEND_RESOURCE=true

# Scopes the agent asks Okta for (Okta's XAA connection decides what is actually granted)
RETAIL_SCOPES=products:read inventory:read orders:read customers:read orders:write returns:read returns:write

# ───────── Retail Authorization Server (port 5101) ─────────
AUTH_PORT=5101
# Issuer URL of the retail authorization server. This is the ID-JAG audience: enter the SAME value
# as the resource authorization server issuer in Okta's XAA connection.
RETAIL_AUTH_ISSUER=http://localhost:5101
# The agent's credentials AT the retail AS. Configure the same client id in Okta's resource connection
# ("AI agent's client ID registered in this app"); the ID-JAG's client_id claim must equal it.
RETAIL_AGENT_CLIENT_ID=agent-at-retail
RETAIL_AGENT_CLIENT_SECRET=change-me-retail-secret
ACCESS_TOKEN_TTL_SECONDS=600

# ───────── Retail Portal (resource server + MCP, port 3101) ─────────
PORTAL_PORT=3101
RETAIL_RESOURCE=http://localhost:3101
# Portal role per user (viewer | support | manager). Matched on the email claim or Okta sub.
# Anyone not listed is provisioned just-in-time as PORTAL_DEFAULT_ROLE.
PORTAL_USER_ROLES=
PORTAL_DEFAULT_ROLE=support

# Additional agents at the auth server (id:secret,id2:secret2). Each also needs its own Okta resource connection.
# RETAIL_AGENT_CLIENTS=

# --- Okta Agent Gateway (brokered consent): authorization-code sign-in on the retail auth server ---
# Must match the credential set you entered in Okta (MCP server > Authorization servers > Brokered consent).
RETAIL_GATEWAY_CLIENT_ID=okta-gateway-test
# Put the SAME client secret you typed in Okta here (demo value; never commit it). Empty = flow disabled.
RETAIL_GATEWAY_CLIENT_SECRET=
# Okta shows the redirect URI in the /authorize request. Comma-separate if you have several.
RETAIL_GATEWAY_REDIRECT_URIS=https://<your-okta-org>.oktapreview.com/oauth2/v1/sts/callback

# --- Okta Agent Gateway test mode: open http://localhost:3000/gateway.html ---
GATEWAY_MCP_URL=https://<your-org>.gateway.oktapreview.com/mcp/servers/<gateway-name>

# --- Real user sign-in for the gateway consent page (instead of the demo picker) ---
# picker = demo (anyone chooses an identity). okta = Okta OIDC sign-in using the agent's own Okta app + private key.
# Before switching to okta: add  <RETAIL_AUTH_ISSUER>/authorize/callback  to the agent app's Sign-in redirect URIs in Okta.
RETAIL_LOGIN_MODE=picker
# Optional: a separate Okta OIDC app instead of the agent's (then also set RETAIL_LOGIN_CLIENT_SECRET)
# RETAIL_LOGIN_CLIENT_ID=
# RETAIL_LOGIN_CLIENT_SECRET=

# --- On-behalf-of (OBO) agent app: second app on the same portal and data. See docs/OBO_AGENT.md ---
# Run it with: npm run start:obo   (or start:all for every app)  ->  http://localhost:3200
# Two Okta CUSTOM authorization servers (https://<org>.okta.com/oauth2/<id>):
#   OBO_LOGIN_ISSUER = where users sign in and get their own access token (the subject token).
#   OBO_ISSUER       = the server that performs the exchange and mints the PORTAL token. It must list the login server
#                      under Settings > Trusted servers. The portal reads OBO_ISSUER and OBO_AUDIENCE too and only trusts
#                      that server (leave both empty and the portal ignores OBO tokens).
# One server is enough for a quick try: leave OBO_LOGIN_ISSUER empty and it defaults to OBO_ISSUER.
OBO_LOGIN_ISSUER=
OBO_ISSUER=
# More Okta custom servers the PORTAL should also trust (comma-separated), e.g. the server behind the Okta MCP Bridge connection.
# Keep OBO_ISSUER a single URL: the OBO agent app uses it as its exchange server.
# OBO_EXTRA_ISSUERS=
# Audience of the OBO_ISSUER server (what the exchanged token's aud will be).
OBO_AUDIENCE=
# The Okta app users sign in with (Native app, Authorization Code + PKCE; leave the secret empty for a native app).
OBO_LOGIN_CLIENT_ID=
OBO_LOGIN_CLIENT_SECRET=
# The Okta "API Services" app that performs the exchange (grant type: Token Exchange). Never commit the secret.
OBO_SERVICE_CLIENT_ID=
OBO_SERVICE_CLIENT_SECRET=
# Scopes asked for in the exchange (they must exist on the custom server and be allowed by its policy rule).
# OBO_SCOPES=products:read inventory:read orders:read customers:read orders:write returns:read returns:write
# Needs the Refresh Token grant on the login app. Lets the agent renew the user's token instead of asking to sign in again.
# OBO_OFFLINE_ACCESS=false
# AGENT_OBO_PORT=3200
# Debug: log the exchanged OBO token. claims = decoded claims only (safe to share). full = also the raw token (a live credential: never leave on).
# OBO_LOG_TOKEN=claims

# --- Okta MCP Bridge agent app (third app): calls the portal THROUGH the Bridge. Run: npm run start:bridge -> http://localhost:3300
# The Bridge is both the OAuth server (sign-in) and the MCP server (/mcp). Its client_id for this app is the Okta AI agent's client id.
BRIDGE_URL=
BRIDGE_CLIENT_ID=
# Standard client mode: paste the "Client Secret Proxy" value from the agent's Bridge settings here (never commit it). Empty = public client.
BRIDGE_CLIENT_SECRET=
# How the secret is sent to the token endpoint: post (default) | basic
# BRIDGE_AUTH_METHOD=post
# BRIDGE_SCOPES=openid offline_access
# BRIDGE_RESOURCE=      # RFC 8707 resource indicator; defaults to BRIDGE_URL
# AGENT_BRIDGE_PORT=3300
# AGENT_BRIDGE_BASE_URL=http://localhost:3300   # must be registered as a redirect URI: <base>/callback
#
# Optional: send the Bridge app's LLM calls through a Kong AI Gateway (the gateway holds the Bedrock key). Only this app is affected.
# BRIDGE_LLM_BASE_URL=http://<gateway-host>:8000/ai   # the model's base path in Kong; the Anthropic SDK adds /v1/messages
# BRIDGE_LLM_MODEL=claude-haiku                       # the model alias set in Kong
# BRIDGE_LLM_API_KEY=                                  # optional placeholder; the real key stays in Kong
