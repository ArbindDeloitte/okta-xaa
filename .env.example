# Copy to .env and fill in. One file is shared by all three services.

# ───────── Okta (the enterprise IdP; issues the ID-JAG) ─────────
# Org authorization server URL, e.g. https://acme.oktapreview.com  (no /oauth2/default)
OKTA_ISSUER=

# The agent app registered in Okta (AI agent's linked OIDC app) - copy its Client ID
AGENT_CLIENT_ID=

# How the agent authenticates to Okta: private_key_jwt (default) | client_secret
#   private_key_jwt: run `npm run gen:key`, paste the printed public JWK into the agent's
#                    "Client registration -> Public/private key" in Okta. (`npm run show:key` re-prints it.)
AGENT_AUTH_METHOD=private_key_jwt
# AGENT_PRIVATE_KEY_FILE=.keys/agent-private.jwk.json
#   Okta may assign its OWN Key ID to the public key you paste in. If the KID shown in Okta differs from `npm run show:key`,
#   set it here (the JWT header kid must equal Okta's Key ID):
# AGENT_KEY_ID=
#   client_secret:   set AGENT_AUTH_METHOD=client_secret and AGENT_CLIENT_SECRET below
# AGENT_CLIENT_SECRET=

# ───────── Agent app (port 3000) ─────────
AGENT_PORT=3000
AGENT_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
# Set to true to also end the Okta session on sign-out (needs http://localhost:3000/ registered as a sign-out redirect URI)
# AGENT_OKTA_LOGOUT=false

# ───────── LLM: pick ONE provider ─────────
# LLM_PROVIDER=anthropic | groq   (default: auto; groq only if it is the only key present)
# Option 1: Anthropic API (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Option 2: Groq (OpenAI-compatible, has a free tier with rate limits). Key: console.groq.com/keys (gsk_..., 56 chars)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Option 3: Claude on Amazon Bedrock (Mantle, Anthropic-compatible endpoint) instead of api.anthropic.com ---
#   Put the Bedrock API key in ANTHROPIC_API_KEY (or BEDROCK_API_KEY). Short-term Bedrock keys expire after hours: regenerate when you see "Signature expired".
# ANTHROPIC_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/anthropic
# AGENT_MODEL_ID=anthropic.claude-haiku-4-5
# AWS_REGION=us-east-1

# What the agent exchanges for the ID-JAG: refresh_token (current Okta docs) | id_token (older flow)
# XAA_SUBJECT_TOKEN=refresh_token
# XAA_SEND_RESOURCE=true

# Scopes the agent asks Okta for (Okta's XAA connection decides what is actually granted)
RETAIL_SCOPES=products:read inventory:read orders:read customers:read orders:write returns:read returns:write

# ───────── Retail Authorization Server (port 5101) ─────────
AUTH_PORT=5101
# Issuer URL of the retail authorization server. This is the ID-JAG audience: enter the SAME value
# as the resource authorization server issuer in Okta's XAA connection.
RETAIL_AUTH_ISSUER=http://localhost:5101
# The agent's credentials AT the retail AS. Configure the same client id in Okta's resource connection
# ("AI agent's client ID registered in this app"); the ID-JAG's client_id claim must equal it.
RETAIL_AGENT_CLIENT_ID=agent-at-retail
RETAIL_AGENT_CLIENT_SECRET=change-me-retail-secret
ACCESS_TOKEN_TTL_SECONDS=600

# ───────── Retail Portal (resource server + MCP, port 3101) ─────────
PORTAL_PORT=3101
RETAIL_RESOURCE=http://localhost:3101
# Portal role per user (viewer | support | manager). Matched on the email claim or Okta sub.
# Anyone not listed is provisioned just-in-time as PORTAL_DEFAULT_ROLE.
PORTAL_USER_ROLES=
PORTAL_DEFAULT_ROLE=support

# Additional agents at the auth server (id:secret,id2:secret2). Each also needs its own Okta resource connection.
# RETAIL_AGENT_CLIENTS=
